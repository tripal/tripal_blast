<?php

/**
 * @file
 * The .module file of Tripal BLAST.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function tripal_blast_theme($existing, $type, $theme, $path) {
  return \Drupal::service('tripal_blast.hook_service')->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_blast_linkout_info().
 */
#[LegacyHook]
function tripal_blast_blast_linkout_info() {
  return \Drupal::service('tripal_blast.hook_service')->blastLinkoutInfo();
}
