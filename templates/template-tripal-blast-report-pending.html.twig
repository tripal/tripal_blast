{#
/**
 * Template to keep the user updated on the progress of their BLAST search.
 *
 * Available Variables:
 *  - $status_code: a numerical code describing the status of the job. See the
 *    CODE column in the table below for possible values.
 *  - $status: a string describing the status of the job. See the STATUS column
 *    in the table below for possible values.
 *  - $refresh_time: a numerical value in milliseconds of how long to wait
 *    before automatically refreshing the page.
 *
 *    CODE    STATUS      DESCRIPTION
 *     0      Pending     The tripal job has been created but has not yet been launched.
 *     1      Running     The Tripal job is currently running.
 *     2      Error       The Tripal job was not started within a reasonable time.
 *    666     Error       The Tripal job encountered an error.
 *    999     Cancelled   The Tripal job was cancelled by an administrator.
 */
#}

{# Provides the automatic page refresh for running jobs. #}
{% if job.status_code <= 1 %}
  <script>
    setTimeout(function() {
      window.location.reload();
    }, {{ job.refresh_time }});
  </script>
{% endif %}

<div>
  {% if job.status_code === 0 %}
    <p>Your BLAST search has been registered and will be started shortly. This page will automatically refresh.</p>
  {% elseif job.status_code === 1 %}
    <p>Your BLAST search is currently running, elapsed time {{ job.run_time }}. The results will be listed here as soon as it completes. This page will automatically refresh.</p>
  {% elseif job.status_code === 2 %}
    <p>Your BLAST search could not be started. The job running service may be down. Please contact the site administrator.</p>
  {% elseif job.status_code === 666 %}
    <p>Your BLAST search has encountered an error. Please contact an administrator for assistance.</p>
  {% elseif job.status_code === 999 %}
    <p>Unfortunately your BLAST search has been cancelled by an Administrator.</p>
  {% endif %}
</div>
