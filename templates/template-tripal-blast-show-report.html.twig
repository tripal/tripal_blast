{#
/**
 * Display the results of a BLAST job execution.
 */
#}

{# attach our css and js library #}
{{ attach_library('tripal_blast/tripal-blast-report') }}

<div class="blast-report">
  <div class="blast-job-info">
    <div class="blast-download-info"><strong>Download</strong>:
      {% for file in report.files.result %}
        {% if file.uri is not empty %}
          <a href="{{ file_url(file.uri) }}" class="blast-download-link" target="_blank">{{ file.label|trim }}</a>{% if not loop.last %}, {% else %}.{% endif %}
        {% endif %}
      {% endfor %}
    </div>
    <br />
    <div class="blast-query-info"><strong>Query Information</strong>:
      {{ report.files.query }}
    </div>
    <div class="blast-target-info"><strong>Search Target</strong>:
      {{ report.blastdb.db_name }}
    </div>
    <div class="blast-date-info"><strong>Submission Date</strong>:
      {{ report.submission_date }}
    </div>
    <div class="blast-cmd-info"><strong>BLAST Command executed</strong>:
      {{ report.blast_cmd }}
    </div>
    <br />
    <div class="num-results">
    <strong>Number of Results</strong>: {{ report.num_results }}
    </div>
  </div>

  <br />

  <div class="report-table">
    {# We are using the drupal table theme functionality to create this listing #}
    {# @see theme_table() for additional documentation #}

    {% if report.xml and report.num_results > 0 %}
      <h2>Resulting BLAST hits</h2>

      <p>
        The following table summarizes the results of your BLAST.
        Click on any row to see the sequence alignment and a visualization of the hit.
        {{ report.linkout_supported|raw }}
      </p>

      <table id="blast_report">
        <thead>
          <tr>
            <th class="arrow-col">&nbsp;</th>
            <th class="number">#</th>
            <th class="query">Query Name (Click for alignment &amp; visualization)</th>
            <th class="hit">Target Name</th>
            <th class="evalue">E-Value</th>
          </tr>
        </thead>
        <tbody>
          {% for row in report.tablerows %}
            <tr class="result-summary" id="result-summary-{{ loop.index }}">
              <td class="arrow-col"><div class="arrow"></div></td>
              <td class="number">{{ row.number }}</td>
              <td class="query">{{ row.query|raw }}</td>
              <td class="hit">{{ row.hit }}</td>
              <td class="evalue">{{ row.evalue }}</td>
            </tr>
            <tr class="alignment-row" id="alignment-row-{{ loop.index }}" style="display: hidden;">
              <td colspan="5">
                <div class="alignment-row-section hit-visualization" title="Your query sequence is shown at the bottom and the target sequence it aligned to is shown at the top. The shape connecting them indicates how much of the target and query are represented by the hit.">
                  <div class="title">Hit Visualization</div>
                  <img src="data:image/png;base64,{{ row.hit_visualization }}"/>
                  <p>The image above shows the relationship between query and target for this particular BLAST hit.</p>
                </div>
                <div class="alignment-row-section alignment">
                  <div class="title">Alignment</div>
                    {% for hsp in row.HSPs %}
                      <div class="hsp-title">HSP {{ hsp.Hsp_num }}</div>
                      <div class="alignment-metrics">
                        <span class="identity">
                          Identity=&nbsp;{{ hsp.Hsp_identity }}/{{ hsp['Hsp_align-len'] }} ({{ hsp['Hsp_align-pct'] }}%)
                       </span>,&nbsp;
                       <span class="positive">
                         Positive=&nbsp;{{ hsp.Hsp_positive }}/{{ hsp['Hsp_align-len'] }} ({{ hsp['Hsp_positive-pct'] }}%)
                       </span>,&nbsp;
                       <span class="coord-summary">
                         Query Matches {{ hsp['Hsp_query-from'] }} to {{ hsp['Hsp_query-to'] }},&nbsp;
                         Hit Matches {{ hsp['Hsp_hit-from'] }} to {{ hsp['Hsp_hit-to'] }}
                       </span>
                     </div>
                     <div class="alignment-row">
                       {{ hsp.Hsp_alignment|raw }}
                     </div>

                    {% endfor %}
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>


    {% elseif report.num_results == 0 %}
      <div class="messages warning">
        Your BLAST resulted in no hits. Please try again with a different query or database.
      </div>

    {% elseif report.too_many_results == true %}
      <div class="messages error">
        Your BLAST resulted in {{ report.num_results_formatted }}
        results which is too many to reasonably display. We have provided the result files for
        Download at the top of this page; however, we suggest you re-submit your query using a
        more stringent e-value (i.e. a smaller number)
      </div>
    {% else %}
      <div role="contentinfo" aria-label="warning message" class="messages messages--warning">
        <div role="alert">
          <h2 class="visually-hidden">warning message</h2>
          We encountered an error and are unable to load your BLAST results.
        </div>
      </div>
    {% endif %}
  </div>
</div>
